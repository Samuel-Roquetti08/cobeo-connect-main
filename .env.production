# Valores PÚBLICOS por design — seguros para versionar.
# VITE_SUPABASE_PUBLISHABLE_KEY é protegida por RLS (sem ela, nenhum dado
# sensível é acessível) — o próprio painel do Supabase confirma: "Publishable
# keys can be safely shared publicly". VITE_MP_PUBLIC_KEY é a chave pública do
# Mercado Pago (equivalente à publishable key do Stripe). Nenhum segredo real
# vive aqui.
#
# Existe porque o Cloudflare Workers Builds não repassa as "Build variables"
# configuradas no painel para o processo do `vite build` — commitar isso é
# mais confiável do que depender da configuração do painel.
VITE_SUPABASE_URL=https://nrmpkboniwibjbmswcyr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OTmYcpZQAc11x-u8kc8XPw_-zYu3JNB
VITE_MP_PUBLIC_KEY=APP_USR-232dbbad-f643-4be4-b6a7-a9ae1fa8c51d
